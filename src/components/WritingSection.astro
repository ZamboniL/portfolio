---
import { DEFAULT_LOCALE } from "#i18n/consts.ts";
import Post from "./Post.astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "#i18n/helper.ts";

interface Props {
  showViewAll?: boolean;
}

const { showViewAll } = Astro.props;

const writing = await getCollection("writing");

const posts = writing.toSorted(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const t = useTranslations(Astro.currentLocale, "writing");
---

<section class="writing" transition:name="writing">
  <div class="writing-header">
    <hgroup>
      <h2>{t("title")}</h2>
      <p>{t("description")}</p>
    </hgroup>
    {
      showViewAll && (
        <a
          href={getRelativeLocaleUrl(
            Astro.currentLocale ?? DEFAULT_LOCALE,
            "/writing",
          )}
        >
          {t("all")}
          {" >"}
        </a>
      )
    }
  </div>
  <ul>
    {
      posts.map((post) => (
        <Post
          id={post.id}
          title={post.data.title}
          description={post.data.description}
          href={`/writing/${post.id}`}
          date={post.data.pubDate}
        />
      ))
    }
  </ul>
</section>

<style>
  .writing {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .writing-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  hgroup p {
    font-size: 1.25rem;
    margin: 0;
    font-style: italic;
    color: var(--primary);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  a {
    text-decoration: none;
    font-size: 0.75rem;
    color: var(--gray);
  }

  @media (max-width: 720px) {
    a {
      display: none;
    }
  }
</style>
