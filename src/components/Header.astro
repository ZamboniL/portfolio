---
import { DEFAULT_LOCALE, LOCALES } from "#i18n/consts.ts";
import HeaderLink from "./HeaderLink.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../i18n/helper";

const currentLocale = Astro.currentLocale ?? DEFAULT_LOCALE;
const otherLocale =
	LOCALES.find((locale) => locale !== currentLocale) ?? DEFAULT_LOCALE;

const t = useTranslations(currentLocale, "nav");
const tHead = useTranslations(currentLocale, "head");

const pathWithoutLocale =
	Astro.url.pathname.replace(`/${currentLocale}`, "") || "/";
---

<header>
	<nav transition:animate="none">
		<h2>
			<HeaderLink href={getRelativeLocaleUrl(currentLocale, "/")}>
				{tHead("title")}
			</HeaderLink>
		</h2>
		<div class="internal-links">
			<HeaderLink href={getRelativeLocaleUrl(currentLocale, "/writing")}>
				{t("writing")}
			</HeaderLink>
			<HeaderLink href={getRelativeLocaleUrl(currentLocale, "/about")}>
				{t("about")}
			</HeaderLink>
			<HeaderLink href={getRelativeLocaleUrl(otherLocale, pathWithoutLocale)}>
				{t("locale")}
			</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		padding: 2.5em 0em 2em;
	}

	h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
	}

	nav,
	.internal-links {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.internal-links {
		gap: 2.5em;
	}

	@media (max-width: 600px) {
		header {
			padding: 2em 1em 1.5em;
		}

		.internal-links {
			gap: 1.5rem;
		}
	}
</style>
