---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><HeaderLink href="/">{SITE_TITLE}</HeaderLink></h2>
		<div class="internal-links">
			<HeaderLink href="/blog">writing</HeaderLink>
			<HeaderLink href="/about">about</HeaderLink>
			<HeaderLink href="/#en">EN</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0 auto;
		padding: 2.5em 2em 3em;
		max-width: 696px;
	}

	h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
	}

	nav, .internal-links {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.internal-links {
		gap: 2.5em;
	}

	@media (max-width: 600px) {
		header {
			padding: 2em 1em 3em;
		}
	}
</style>
