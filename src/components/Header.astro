---
import HeaderLink from "./HeaderLink.astro";
import { useTranslations } from "../i18n/helper";

const tNav = useTranslations(Astro.currentLocale, "nav");
const tHead = useTranslations(Astro.currentLocale, "head");
---

<header>
	<nav>
		<h2><HeaderLink href="/">{tHead("title")}</HeaderLink></h2>
		<div class="internal-links">
			<HeaderLink href="/writing">{tNav("writing")}</HeaderLink>
			<HeaderLink href="/about">{tNav("about")}</HeaderLink>
			<HeaderLink href="/#en">{tNav("locale")}</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		padding: 2.5em 0em 2em;
	}

	h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
	}

	nav,
	.internal-links {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.internal-links {
		gap: 2.5em;
	}

	@media (max-width: 600px) {
		header {
			padding: 2em 1em 1.5em;
		}

		.internal-links {
			gap: 1.5rem;
		}
	}
</style>
