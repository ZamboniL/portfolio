<style>
	footer {
		padding: 2em 1em 1em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	h3 {
		font-size: 1.25rem;
	}

	hgroup p {
		font-size: 0.875rem;
		margin: 0;
		color: var(--primary);
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 2rem;
	}
</style>
