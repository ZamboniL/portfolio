---
import { DEFAULT_LOCALE } from "#i18n/consts.ts";
import { getRelativeLocaleUrl } from "astro:i18n";
import { titleShrink } from "#transitions/title.ts";

interface Props {
  id: string;
  title: string;
  description: string;
  date: Date;
  href: string;
}

const { id, date, description, title, href } = Astro.props;

const formatDate = new Intl.DateTimeFormat(Astro.currentLocale, {
  dateStyle: "long",
});

const formattedDate = formatDate.format(date);

const hrefWithLocale = getRelativeLocaleUrl(
  Astro.currentLocale ?? DEFAULT_LOCALE,
  href,
);
---

<li>
  <a href={hrefWithLocale}>
    <strong
      transition:name={`${id}:title`}
      transition:animate={titleShrink}
      data-post-title
    >
      {title}
    </strong>
    <span>
      {description}
    </span>
    <br />
    <small>{formattedDate}</small>
  </a>
</li>

<style>
  a {
    text-decoration: none;
    color: var(--gray);
    padding: 1.5rem 1rem;
    display: block;
  }

  strong {
    view-transition-class: post-title;
    display: block;
    color: var(--gray);
    text-decoration: none;
    font-size: 1.5rem;
  }

  li {
    border-radius: 8px;
    cursor: pointer;
    transform: translateY(0) scale(1);
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  span {
    font-style: italic;
  }

  li:hover {
    transform: translateY(-3px) scale(1.01);
    box-shadow:
      0 1px 3px -2px rgba(0, 0, 0, 0.08),
      0 6px 12px -4px rgba(0, 0, 0, 0.1),
      0 14px 24px -10px rgba(0, 0, 0, 0.12);
  }

  li:active {
    transform: translateY(-1px) scale(1);
    transition-duration: 0.1s;
    box-shadow:
      0 1px 2px -1px rgba(0, 0, 0, 0.1),
      0 3px 6px -2px rgba(0, 0, 0, 0.1);
  }

  @media (prefers-reduced-motion: reduce) {
    li,
    li:active {
      transform: none;
      transition: box-shadow 0.2s ease;
    }

    li:hover {
      transform: none;
    }
  }

  @media (max-width: 720px) {
    a {
      padding: 1.5rem 0.5rem;
    }
  }
</style>
