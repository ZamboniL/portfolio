---
import BaseHead from "#components/BaseHead.astro";
import Footer from "#components/Footer.astro";
import Header from "#components/Header.astro";
import WritingSection from "#components/WritingSection.astro";
import { useTranslations } from "#i18n/helper.ts";
import { withLocales } from "#i18n/paths.ts";

export function getStaticPaths() {
	return withLocales();
}

const tHead = useTranslations(Astro.currentLocale, "head");
const t = useTranslations(Astro.currentLocale, "home");
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={tHead("title")} description={tHead("description")} />
	</head>
	<body>
		<Header />
		<main>
			<p>
				{t("intro")}
			</p>

			<WritingSection showViewAll  />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		display: flex;
		flex-direction: column;
		gap: 2.5em;
	}
</style>
