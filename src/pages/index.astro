---
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<p>
				Hi, I'm Lucas, a software engineer that is starting to blog about web
				development, programming, and technology.
			</p>

			<div class="writing">
				<div class="writing-header">
					<h2>My writing</h2>
					<a href="/blog">View all{" >"}</a>
				</div>
				<ul>
					<li>
						<a href="/blog/2024-06-05-astro-v3.0.0-release-notes">
							<strong>Important Stuff</strong>
						</a>
						<br />
						<span>
							Lorem ipsum dolor sit amet, consectetur adipiscing elit. Curabitur
							in nulla nec quam tincidunt iaculis eu sed est.
						</span>
						<br />
						<small>June 5, 2024</small>
					</li>
					<li>
						<a href="/blog/2024-05-30-astro-v2.9.0-release-notes">
							<strong>Important Stuff</strong>
						</a>
						<br />
						<span>
							Lorem ipsum dolor sit amet, consectetur adipiscing elit. Curabitur
							in nulla nec quam tincidunt iaculis eu sed est.
						</span>
						<br />
						<small>May 30, 2024</small>
					</li>
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		display: flex;
		flex-direction: column;
		gap: 2.5em;
	}

	.writing {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.writing-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	a {
		text-decoration: none;
		font-size: 0.75rem;
		color: var(--gray);
	}

	li a {
		text-decoration: none;
		font-size: 1.5rem;
	}

	span {
		font-style: italic;
	}
</style>
